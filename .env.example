# --- Supabase ---
# Project Settings → API in your Supabase dashboard
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET. server-only.

# --- TMDB ---
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Redis ---
# Local docker-compose ignores this (uses the redis service).
# In production, point at Upstash (free tier works well for this app).
REDIS_URL=redis://localhost:6379

# --- Frontend / API wiring ---
# Where the frontend talks to the backend (build-time env var in Next.js).
# Local: http://localhost:4000  ·  Prod: https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Which origin(s) the backend will accept requests from.
# Comma-separated list. Each entry is either a literal origin OR a glob
# pattern using "*" (handy for Vercel's per-deployment preview URLs).
# Local: leave blank to allow all.
# Prod example (canonical + all preview deploys for a Vercel project):
#   https://your-app.vercel.app,https://your-app-*-yourteam-*.vercel.app
FRONTEND_ORIGIN=

# --- Backend port (Render sets this automatically) ---
PORT=4000
